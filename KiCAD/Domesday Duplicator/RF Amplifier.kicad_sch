  (text "50 Ohm impedance\nRF input" (at 72.39 62.23 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid 8ca1924e-0907-42e8-bc67-6d17f2658d85)
  )
  (text "Note:\nThe cable terminating resistor should\ntake into account the parallel resistance of\nthe dividing network:\n\n1000 / 2 = 500 Ohms\n\nRtotal = R1×R2/(R1+R2)\n(500 x 56) / (500 + 56) = 50.36 Ohms\n"
    (at 52.07 121.92 0)
    (effects (font (size 1.524 1.524)) (justify left bottom))
    (uuid a8e75537-8618-4ed1-9293-94b76f9ea365)
